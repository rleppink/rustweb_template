# Host-side default for `cargo run` / tests. The app fails to start if
# DATABASE_URL is unset. Compose does NOT use this value — the dev service
# reaches postgres by its compose service name.
# Start the DB with `docker compose up -d postgres` (or `just dev`).
DATABASE_URL=postgres://rustweb:rustweb@localhost:5432/rustweb

# Host port for the dev service (`just dev`). Compose does interpolate this
# one; unset → 3000.
PORT=3000

# Host port for the postgres service. Compose does interpolate this one;
# unset → 5432.
# POSTGRES_PORT=5432

# Mark the session cookie `Secure` (HTTPS-only). Leave unset for plain-HTTP
# local dev; set to 1 when the app is served behind TLS.
# COOKIE_SECURE=1

# Per-IP rate limiting on /auth/* (register, login, logout, me, password
# reset). `burst` is how many requests a client may fire before being
# throttled; `per_second` is the refill rate, in requests per second.
# Unset → burst 10, refill 5/s.
# AUTH_RATE_LIMIT_PER_SECOND=5
# AUTH_RATE_LIMIT_BURST=10

# Lifetime of a password-reset token, in minutes (1..=1440). Unset → 60.
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Public origin used to build reset links in emails. The dev mailer only
# logs them; a real mailer will send them. Unset → http://localhost:3000.
# PUBLIC_BASE_URL=http://localhost:3000
